{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plano-de-estudos/schemas/unidades/v1",
  "title": "catalogo/unidades.yml",
  "description": "Unidades do curso de Engenharia de Software.",
  "type": "object",
  "required": ["schema_version", "unidades"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "unidades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "nome", "semestre", "nivel"],
        "anyOf": [{"required": ["prerequisitos"]}, {"required": ["prerequisitos_texto"]}],
        "description": "Cada unidade tem prerequisitos ou prerequisitos_texto.",
        "additionalProperties": false,
        "properties": {
          "codigo": {"type": "string", "pattern": "^U[0-9]+\\.[0-9]+$"},
          "nome": {"type": "string", "minLength": 1},
          "semestre": {"type": "integer", "minimum": 1, "maximum": 18},
          "nivel": {"enum": ["Base", "Intermediário", "Avançado"]},
          "prerequisitos": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(U[0-9]+\\.[0-9]+|[A-Z]{1,2}[0-9]+)$"}, "description": "Códigos de unidade ou de disciplina."},
          "prerequisitos_texto": {"type": "string", "minLength": 1},
          "apoio": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
